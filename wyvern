local function setStatus(text, kind)
	local color = COLORS.Muted
	if kind == "ok" then color = COLORS.Ok
	elseif kind == "warn" then color = COLORS.Warn
	elseif kind == "error" then color = COLORS.Error
	elseif kind == "info" then color = CONFIG.Accent2 end
	status.Text = text
	tween(status, 0.2, { TextColor3 = color })
	tween(statusDot, 0.2, { BackgroundColor3 = color })
end

local function setEnabled(state)
	getBtn.Active = state
	getBtn.AutoButtonColor = false
	checkBtn.Active = state
	tween(checkBtn, 0.15, { BackgroundTransparency = state and 0 or 0.55 })
	tween(getBtn, 0.15, { BackgroundTransparency = state and 0 or 0.7 })
	keyBox.TextEditable = state
end

local function shake()
	local base = main.Position
	local seq = { -8, 8, -5, 5, -2, 0 }
	task.spawn(function()
		for _, offset in ipairs(seq) do
			main.Position = UDim2.new(base.X.Scale, base.X.Offset + offset, base.Y.Scale, base.Y.Offset)
			task.wait(0.035)
		end
		main.Position = base
	end)
end

