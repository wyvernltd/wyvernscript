local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
		shadow.Position = main.Position
	end
end)

local function openLink(url)
	local copied = false
	if clipboard then
		copied = pcall(clipboard, url)
	end
	local opened = pcall(function()
		GuiService:OpenBrowserWindow(url)
	end)
	if opened then
		setStatus("Key page opened in your browser.", "info")
	elseif copied then
		setStatus("Link copied to clipboard, paste it in your browser.", "warn")
	else
		setStatus("Could not open the link automatically.", "error")
	end
end

getBtn.MouseButton1Click:Connect(function()
	if busy then return end
	openLink(CONFIG.KeyLink)
end)

local function fail(message)
	busy = false
	setEnabled(true)
	checkBtn.Text = "Check Key"
	setStatus(message, "error")
	shake()
end

submitKey = function()
	if busy or closed then return end

	local key = (keyBox.Text:gsub("^%s*(.-)%s*$", "%1"))
	if key == "" then
		setStatus("Please enter your key first.", "warn")
		shake()
		return
	end

	busy = true
	setEnabled(false)
	checkBtn.Text = "Checking..."
	setStatus("Validating key, please wait...", "info")
	task.wait(0.15)

	getgenv().lp_key = key

	local source
	local okFetch = pcall(function()
		source = httpGet(CONFIG.Loader)
	end)

	if not okFetch or type(source) ~= "string" or source == "" then
		return fail("Could not reach the server. Check your connection.")
	end

	local fn, compileErr = loadstring(source)
	if not fn then
		return fail("Loader error: " .. tostring(compileErr))
	end

	checkBtn.Text = "Loading"
	setStatus("Key sent, starting the script...", "info")

	local finished, failed, errMsg = false, false, nil
	task.spawn(function()
		local ok, err = pcall(fn)
		finished = true
		if not ok then
			failed = true
			errMsg = err
		end
	end)

	local elapsed = 0
	while not finished and elapsed < 4 do
		elapsed += task.wait(0.1)
	end

	if failed then
		return fail("Invalid key or the script failed: " .. tostring(errMsg))
	end

	setStatus("Key accepted. Enjoy!", "ok")
	task.wait(0.4)
	close()
end

checkBtn.MouseButton1Click:Connect(submitKey)

closeBtn.MouseButton1Click:Connect(function()
