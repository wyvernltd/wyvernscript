local function close()
	if closed then return end
	closed = true
	tween(blur, 0.3, { Size = 0 })
	tween(shadow, 0.25, { ImageTransparency = 1, Size = UDim2.new(0, 380, 0, 260) })
	tween(main, 0.25, { BackgroundTransparency = 1, Size = UDim2.new(0, 400, 0, 0) }, Enum.EasingStyle.Quad)
	for _, v in ipairs(main:GetDescendants()) do
		if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
			tween(v, 0.15, { TextTransparency = 1 })
		end
		if v:IsA("Frame") or v:IsA("TextButton") or v:IsA("TextBox") then
			tween(v, 0.15, { BackgroundTransparency = 1 })
		end
		if v:IsA("UIStroke") then
			tween(v, 0.15, { Transparency = 1 })
		end
	end
	task.delay(0.35, function()
		pcall(function() blur:Destroy() end)
		pcall(function() screen:Destroy() end)
	end)
end

local function hover(button, hoverColor, normalColor)
	button.MouseEnter:Connect(function()
		if not button.Active then return end
		tween(button, 0.15, { BackgroundColor3 = hoverColor })
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.15, { BackgroundColor3 = normalColor })
	end)
end

