    local function reloadvm()
        pcall(function()
            local CurrentViewmodel = InventoryController.getCurrentEquipped()
            if type(CurrentViewmodel) ~= "table" then return end
            
            local vm = CurrentViewmodel.Viewmodel
            if type(vm) ~= "table" then return end

            local cName = CurrentViewmodel.Name
            if not cName then return end

            if Checkknife(cName) then
                vm.Weapon = Cfg.TargetKnife or W.TK or "Karambit"
                local skin = Cfg.TargetSkin or W.TS or "Vanilla"
                vm.Skin = skin == "" and "Vanilla" or skin
            elseif Cfg.ActiveGunSkins and Cfg.ActiveGunSkins[cName] then
                vm.Weapon = cName
                vm.Skin = Cfg.ActiveGunSkins[cName]
            end

            local old = vm.Model
            vm:construct(game:GetService("Players").LocalPlayer.Character, CurrentViewmodel)
            
            if not vm.Model or typeof(vm.Model) ~= "Instance" then return end
            
            vm.Model.Parent = workspace.CurrentCamera
            if old and typeof(old) == "Instance" then old:Destroy() end

            local anim = vm.Animation
            if type(anim) ~= "table" then return end
            
            local animator = vm.Model:FindFirstChild("AnimationController") and vm.Model.AnimationController:FindFirstChild("Animator")
            if not animator then return end

            if anim.stopAnimations then anim:stopAnimations() end
            anim.Animator = animator
            anim.Animation = vm.Model.Name
            anim.Animations = {}
            anim.Connections = anim.Connections or {}

            local mName = vm.Model.Name
            local animFolder=(function() for _,v in ipairs(game:GetChildren())do local s,r=pcall(function() return v:FindFirstChild("Assets") and v.Assets:FindFirstChild("WeaponAnimations") end) if s and r then return r:FindFirstChild(mName) end end return nil end)();
            
            if animFolder and animFolder:FindFirstChild("CameraAnimations") then
                for _, a in ipairs(animFolder.CameraAnimations:GetChildren()) do
                    if a and a.Name then
                        anim.Animations[a.Name] = animator:LoadAnimation(a)
                    end
                end
            end
            if anim.play then anim:play("Idle") end
        end)
    end

    if UI and UI.GAB then
        UI.GAB.MouseButton1Click:Connect(function()
            reloadvm()
        end)
    end
