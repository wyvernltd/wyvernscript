local function SafeGameShoot()
    -- m1p veya m1c kullanmak yerine, hafızadaki silah tablosunun orijinal Shoot fonksiyonunu tetikliyoruz
    for v, _ in pairs(W.AWT or {}) do
        if type(v) == "table" and type(rawget(v, "Shoot")) == "function" then
            pcall(function() v:Shoot() end)
        end
    end
end

local isClicking = false

UIS.InputBegan:Connect(function(i, gp)
    if not isClicking and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then 
        W.iC = true 
    end 
end)

UIS.InputEnded:Connect(function(i)
    if not isClicking and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then 
        W.iC = false 
    end 
end)

t_spawn(function()
    while t_wait() do 
        if W.iC and Cfg.AutoClicker then 
            isClicking = true
            
            W.GASW = true
            if m1c and not isMob then
                pcall(m1c)
            elseif m1p and m1r and not isMob then
                pcall(m1p)
                t_wait(0.01)
                pcall(m1r)
            end
            t_wait(0.01)
            W.GASW = false
            
            t_wait((tonumber(Cfg.AutoClickerDelay) or 50) / 1000)
            isClicking = false
        end 
    end 
end)

W.ORecoil = {}
W.OSpread = {}

local function FWM(v)
    if type(v) ~= "table" then return end
    
    -- [1] ESKİ RAPID FIRE KODLARI
    if rawget(v, "FireRate") then 
        if not W.OFR[v] then W.OFR[v] = v.FireRate end
        if type(rawget(v, "Shoot")) == "function" and not rawget(v, "WyvernRapid") then 
            rawset(v, "WyvernRapid", true)
            local oS = v.Shoot
            v.Shoot = function(s, ...)
                if Cfg.RapidFire or Cfg.RageMode then 
                    s.FireRate = Cfg.RageMode and 0 or ((tonumber(Cfg.RapidFireDelay) or 10) / 1000)
                    if rawget(s, "NextFire") then s.NextFire = 0 end 
                end 
                return oS(s, ...)
            end 
        end
        if Cfg.RapidFire or Cfg.RageMode then 
            if setreadonly then setreadonly(v, false) end
            v.FireRate = Cfg.RageMode and 0 or ((tonumber(Cfg.RapidFireDelay) or 10) / 1000)
            if rawget(v, "Auto") ~= nil then v.Auto = true end
            if setreadonly then setreadonly(v, true) end 
        else 
            if W.OFR[v] then 
                if setreadonly then setreadonly(v, false) end
                v.FireRate = W.OFR[v]
                if setreadonly then setreadonly(v, true) end 
            end 
        end 
    end
    
    -- [2] ESKİ INSTA RELOAD KODLARI
    if rawget(v, "State") and rawget(v, "Class") ~= "Melee" then 
        if Cfg.InstaReload or Cfg.RageMode then 
            if v.State == "Reloading" then 
                v.State = "Idle"
                if rawget(v, "IsReloading") ~= nil then v.IsReloading = false end
                if rawget(v, "NextFire") then v.NextFire = 0 end 
            end 
        end 
