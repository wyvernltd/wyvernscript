local CFN = "WyvernBloxstrike_MasterConfig.json"
local _writefile = writefile or (getgenv and getgenv().writefile)
local _readfile = readfile or (getgenv and getgenv().readfile)

local function GMC()
    if _readfile then 
        local s, c = pcall(function() return _readfile(CFN) end)
        if s and type(c) == "string" and c ~= "" then 
            local dS, d = pcall(function() return HS:JSONDecode(c) end)
            if dS and type(d) == "table" then 
                return d 
            end 
        end 
    end 
    return {}
end

local function SCf(n)
    if not _writefile then return false end
    local m = GMC()
    local dTS = {}
    for k, v in pairs(Cfg) do 
        if typeof(v) == "EnumItem" then 
            dTS[k] = "ENUM_" .. tostring(v) 
        else 
            dTS[k] = v 
        end 
    end
    m[n] = dTS
    return pcall(function() _writefile(CFN, HS:JSONEncode(m)) end)
end

local function LCf(n)
    local m = GMC()
    local d = m[n]
    if not d or type(d) ~= "table" then return false end
    
    for k, v in pairs(d) do 
        if k == "TargetKnife" then 
            W.TK = v
            Cfg.TargetKnife = v 
        elseif k == "TargetSkin" then 
            W.TS = v
            Cfg.TargetSkin = v 
        elseif k == "TargetGlove" then 
            W.TG = v
            Cfg.TargetGlove = v 
        elseif k == "TargetSkinGlove" then 
            W.TSG = v
            Cfg.TargetSkinGlove = v 
        elseif k == "ActiveGunSkins" then 
            Cfg.ActiveGunSkins = v 
        elseif type(v) == "string" and s_sub(v, 1, 5) == "ENUM_" then 
            local p = s_split(s_sub(v, 6), ".")
            pcall(function()
                local lE = Enum[p[2]][p[3]]
                if Upd[k] then 
                    Upd[k](lE) 
                else 
                    Cfg[k] = lE 
                end 
            end)
        else 
            if Upd[k] then 
                Upd[k](v) 
            else 
                Cfg[k] = v 
            end 
        end 
    end
    
    Cfg.HitboxScanning = true
    Cfg.ViewAngleSpoof = true
    Cfg.InterpolatedSpoof = true
    Cfg.InterpSmoothness = 1.2
